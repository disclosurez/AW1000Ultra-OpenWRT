#!/bin/sh /etc/rc.common
# Cloudflare Tunnel connector (cloudflared) for mapping LAN hosts to
# Cloudflare-managed hostnames.
#
# One procd instance per "config tunnel" section in /etc/config/cloudflare:
#
#   config tunnel 'main'
#       option enabled    '1'
#       option name       'router'
#       option token_file '/etc/cloudflare-tunnel-main.token'
#       option metrics    '127.0.0.1:0'      # optional
#
# The connector token comes from the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> install connector). Ingress / public
# hostnames are managed in the dashboard for token-based tunnels.

START=98
STOP=10
USE_PROCD=1

CFD_BIN=/data/cloudflare/bin/cloudflared
CFD_BIN_FALLBACK=/usr/bin/cloudflared

bin_path() {
	if [ -x "$CFD_BIN" ]; then
		echo "$CFD_BIN"
	elif [ -x "$CFD_BIN_FALLBACK" ]; then
		echo "$CFD_BIN_FALLBACK"
	fi
}

start_service() {
	config_load cloudflare
	config_foreach start_tunnel tunnel
}

start_tunnel() {
	local cfg="$1" enabled name token_file metrics bin
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get name       "$cfg" name       "$cfg"
	config_get token_file "$cfg" token_file "/etc/cloudflare-tunnel-$cfg.token"
	config_get metrics    "$cfg" metrics    '127.0.0.1:0'

	bin=$(bin_path)
	if [ -z "$bin" ]; then
		logger -t cloudflared "binary missing ($CFD_BIN) — $name not started"
		return 0
	fi

	if [ ! -s "$token_file" ]; then
		logger -t cloudflared "no connector token in $token_file — $name not started"
		return 0
	fi

	procd_open_instance "$cfg"
	procd_set_param command "$bin" tunnel --no-autoupdate --metrics "$metrics" run --token-file "$token_file"
	procd_set_param respawn 3600 10 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t cloudflared "started tunnel '$name'"
}

service_triggers() {
	procd_add_reload_trigger "cloudflare"
}
