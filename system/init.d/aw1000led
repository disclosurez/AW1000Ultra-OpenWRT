#!/bin/sh /etc/rc.common
# AW1000 LED controller: drives the LEDs from the real uplink state.
#
# Starts after the vendor led_ctrld (S21) so it can park it first, and keeps
# applying the LED state every few seconds — the vendor daemon rewrote the
# sysfs triggers continuously, which is why the stock LED Configuration page
# never stuck.

START=22
STOP=09
USE_PROCD=1

start_service() {
	local enabled
	config_load leds
	config_get_bool enabled settings enabled 1

	if [ "$enabled" = 1 ]; then
		/usr/sbin/aw1000-led takeover >/dev/null 2>&1
	else
		/usr/sbin/aw1000-led release >/dev/null 2>&1
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/aw1000-led daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t aw1000-led "service started"
}

stop_service() {
	# Hand the LEDs back to the vendor daemon on a clean stop.
	/usr/sbin/aw1000-led release >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger "leds"
}

reload_service() {
	stop
	start
}
