#!/bin/sh /etc/rc.common
# HTTPS front door: terminates TLS with the router certificate on :443 and
# serves both LuCI (proxied to uhttpd :80) and the OpenCode app under /oc/.
# Needs uhttpd's HTTPS listener removed; see AGENTS.md §7d.
START=97
STOP=05
USE_PROCD=1

BIN=/data/ocgate/bin/ocgate

start_service() {
	config_load opencode
	config_get_bool enabled settings enabled 1
	config_get port settings port 8091

	[ "$enabled" = "1" ] || { echo "ocgate disabled"; return 0; }
	[ -x "$BIN" ] || { logger -t ocgate "binary missing: $BIN"; return 1; }
	[ -f /etc/uhttpd.crt ] || { logger -t ocgate "no certificate"; return 1; }

	# uhttpd stores its certificate as DER on this firmware; Go wants PEM.
	if [ ! -f /etc/ocgate.crt ] || [ /etc/uhttpd.crt -nt /etc/ocgate.crt ]; then
		openssl x509 -in /etc/uhttpd.crt -out /etc/ocgate.crt 2>/dev/null || \
			openssl x509 -inform DER -in /etc/uhttpd.crt -out /etc/ocgate.crt
	fi

	procd_open_instance
	procd_set_param command "$BIN" \
		-listen 0.0.0.0:443 \
		-cert /etc/ocgate.crt -key /etc/uhttpd.key \
		-uhttpd http://127.0.0.1:80 \
		-ocproxy "http://127.0.0.1:$port"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
