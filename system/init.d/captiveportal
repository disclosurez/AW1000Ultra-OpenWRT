#!/bin/sh /etc/rc.common
# Captive portal splash / terms page.
#
# Runs a dedicated uhttpd instance on /www/portal (the LuCI one on :80 is left
# untouched) and gates clients entering the router on the network interface
# selected in UCI until they accept the terms.

START=97
STOP=10
USE_PROCD=1

PORTAL_ROOT=/www/portal

start_service() {
	local enabled port

	config_load captiveportal
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || {
		logger -t captive-portal "disabled in /etc/config/captiveportal"
		/usr/sbin/captiveportal clear >/dev/null 2>&1
		return 0
	}

	config_get port main port 8088
	[ -n "$port" ] || port=8088

	[ -d "$PORTAL_ROOT" ] || {
		logger -t captive-portal "$PORTAL_ROOT missing — not starting"
		return 0
	}

	/usr/sbin/captiveportal apply >/dev/null 2>&1
	/usr/sbin/captiveportal sync >/dev/null 2>&1

	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd \
		-f -p "0.0.0.0:$port" -h "$PORTAL_ROOT" -x /cgi-bin \
		-E /cgi-bin/splash \
		-t 60 -T 20 -k 5 -n 20 -N 64 -r "Guest Wi-Fi"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t captive-portal "splash page listening on port $port"
}

stop_service() {
	/usr/sbin/captiveportal clear >/dev/null 2>&1
}
