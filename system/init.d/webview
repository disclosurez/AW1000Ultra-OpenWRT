#!/bin/sh /etc/rc.common
# Link-rewriting web gateway (Tools -> Web Viewer).
# The binary lives on /data (not the 144 MB overlay); build it with
# ./build-webview.sh in the repo. Configuration: /etc/config/webview.

START=95
STOP=10
USE_PROCD=1

BIN=/data/webview/bin/webview

start_service() {
	config_load webview
	config_get_bool enabled settings enabled 1
	config_get port settings port 8090
	config_get_bool vpn settings vpn 1

	[ "$enabled" = "1" ] || { echo "webview disabled"; return 0; }
	[ -x "$BIN" ] || { logger -t webview "binary missing: $BIN"; return 1; }

	vpn_mark=""
	if [ "$vpn" = "1" ] && [ -x /usr/sbin/webview-vpn ]; then
		/usr/sbin/webview-vpn apply
		vpn_mark="-mark 0x2"
	else
		[ -x /usr/sbin/webview-vpn ] && /usr/sbin/webview-vpn disable
	fi

	# Listen on every address so the frame works whichever address the console
	# was opened on (LAN IP, hostname or the WireGuard address). The WAN zone
	# still drops the port.
	procd_open_instance
	procd_set_param command "$BIN" -addr "0.0.0.0:$port" $vpn_mark
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
