#!/bin/sh /etc/rc.common
# Cloudflare DDNS updater — https://github.com/favonia/cloudflare-ddns
#
# Settings live in /etc/config/cloudflare (section "ddns").
# The API token lives in /etc/cloudflare-ddns.token (mode 600) and is passed
# through CLOUDFLARE_API_TOKEN_FILE so it never appears in argv or the
# environment.

START=99
STOP=10
USE_PROCD=1

DDNS_BIN=/data/cloudflare/bin/cloudflare-ddns
DDNS_BIN_FALLBACK=/usr/bin/cloudflare-ddns
DEFAULT_TOKEN=/etc/cloudflare-ddns.token

bin_path() {
	if [ -x "$DDNS_BIN" ]; then
		echo "$DDNS_BIN"
	elif [ -x "$DDNS_BIN_FALLBACK" ]; then
		echo "$DDNS_BIN_FALLBACK"
	fi
}

start_service() {
	local enabled domains proxied ip4 ip6 cron token_file bin

	config_load cloudflare
	config_get_bool enabled ddns enabled 1
	[ "$enabled" = 1 ] || {
		logger -t cloudflare-ddns "disabled in /etc/config/cloudflare"
		return 0
	}

	config_get domains    ddns domains      ''
	config_get proxied    ddns proxied      '0'
	config_get ip4        ddns ip4_provider 'cloudflare.trace'
	config_get ip6        ddns ip6_provider 'none'
	config_get cron       ddns update_cron  '@every 5m'
	config_get token_file ddns token_file   "$DEFAULT_TOKEN"

	if [ -z "$domains" ]; then
		logger -t cloudflare-ddns "no domains configured — not starting"
		return 0
	fi

	# /data is a separate ext4 partition; give it a moment on early boot.
	local i=0
	while [ ! -x "$DDNS_BIN" ] && [ $i -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done

	bin=$(bin_path)
	if [ -z "$bin" ]; then
		logger -t cloudflare-ddns "binary missing ($DDNS_BIN) — not starting"
		return 0
	fi

	if [ ! -s "$token_file" ]; then
		logger -t cloudflare-ddns "API token file $token_file missing or empty — not starting"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$bin"
	procd_set_param env \
		CLOUDFLARE_API_TOKEN_FILE="$token_file" \
		DOMAINS="$domains" \
		PROXIED="$proxied" \
		IP4_PROVIDER="$ip4" \
		IP6_PROVIDER="$ip6" \
		UPDATE_CRON="$cron" \
		TZ=UTC
	# threshold timeout retries: restart quickly, but give up after 5 tries/hour.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t cloudflare-ddns "started for [$domains] (ipv4=$ip4 ipv6=$ip6 proxied=$proxied)"
}

service_triggers() {
	procd_add_reload_trigger "cloudflare"
}
