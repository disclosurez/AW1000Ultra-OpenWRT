#!/bin/sh /etc/rc.common
# Router-side client for an OpenCode server: pairs with it once, then
# reverse-proxies the web UI on the LAN so it can be embedded in LuCI.
# Binary: /data/ocproxy/bin/ocproxy (build with ./build-ocproxy.sh).

START=95
STOP=10
USE_PROCD=1

BIN=/data/ocproxy/bin/ocproxy
RUNDIR=/tmp/ocproxy

lan_ip() {
	local ip
	ip=$(uci -q get network.lan.ipaddr)
	[ -n "$ip" ] || ip=192.168.0.1
	echo "$ip"
}

esc() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/ /g'
}

start_service() {
	config_load opencode
	config_get_bool enabled settings enabled 1
	config_get port settings port 8091
	config_get upstream settings upstream ""
	config_get password settings password ""
	config_get pair_url settings pair_url ""
	config_get_bool insecure settings insecure 0

	[ "$enabled" = "1" ] || { echo "opencode disabled"; return 0; }
	[ -x "$BIN" ] || { logger -t ocproxy "binary missing: $BIN"; return 1; }

	mkdir -p "$RUNDIR"
	chmod 700 "$RUNDIR"
	printf '{"listen":"0.0.0.0:%s","upstream":"%s","password":"%s","pair_url":"%s","insecure":%s}\n' \
		"$port" "$(esc "$upstream")" "$(esc "$password")" "$(esc "$pair_url")" \
		"$([ "$insecure" = "1" ] && echo true || echo false)" > "$RUNDIR/config.json"
	chmod 600 "$RUNDIR/config.json"

	procd_open_instance
	procd_set_param command "$BIN" -config "$RUNDIR/config.json"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$RUNDIR/config.json"
}
