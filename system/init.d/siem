#!/bin/sh /etc/rc.common
# SIEM log forwarding service.
#
# One procd instance spools and ships events; each enabled source runs its own
# collector so a blocked file read cannot stall the syslog stream (and vice
# versa). Configuration: /etc/config/siem (LuCI: Services -> SIEM Forwarding).
#
#   config settings 'settings'
#       option enabled  '1'
#       option sources  'syslog dns portal'
#
#   config target 'target'
#       option enabled  '1'
#       option transport 'syslog'      # or http
#       option host 'siem.example.com'
#       option port '6514'
#       option proto 'tls'             # udp | tcp | tls
#       option url 'https://…'         # http transport only

START=99
STOP=10
USE_PROCD=1

. /lib/functions.sh

SIEM=/usr/sbin/siem-forward

start_service() {
	local enabled tenabled transport host url sources src

	config_load siem

	config_get_bool enabled  settings enabled 0
	config_get_bool tenabled target   enabled 1
	config_get      transport target   transport syslog
	config_get      host      target   host ""
	config_get      url       target   url ""
	config_get      sources   settings sources "syslog dns"

	if [ "$enabled" != 1 ] || [ "$tenabled" != 1 ]; then
		logger -t siem "service disabled"
		return 0
	fi

	if [ "$transport" = http ] && [ -z "$url" ]; then
		logger -t siem "http target has no url; not starting"
		return 0
	fi
	if [ "$transport" != http ] && [ -z "$host" ]; then
		logger -t siem "syslog target has no host; not starting"
		return 0
	fi

	procd_open_instance flush
	procd_set_param command "$SIEM" flush-loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 10
	procd_close_instance

	for src in $sources; do
		case "$src" in
			syslog|dns|portal) ;;
			*) logger -t siem "ignoring unknown source '$src'"; continue ;;
		esac
		procd_open_instance "collect_$src"
		procd_set_param command "$SIEM" collect "$src"
		procd_set_param respawn 3600 5 10
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param nice 10
		procd_close_instance
	done

	logger -t siem "started: $transport target, sources: $sources"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "siem"
}
