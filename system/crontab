# Cron entries this build relies on. The installer merges them into
# /etc/crontabs/root (no duplicates). Kept here for reference.
#
# Every-minute tasks keep state in /tmp, so they are cheap and self-healing.

* * * * * /usr/sbin/vpnplit-route >/dev/null 2>&1
*/5 * * * * /usr/sbin/vpnsplit-warm >/dev/null 2>&1
* * * * * /usr/sbin/parental-control apply >/dev/null 2>&1
* * * * * /usr/sbin/captiveportal sync >/dev/null 2>&1
*/3 * * * * /usr/sbin/parental-acct >/dev/null 2>&1
*/15 * * * * /usr/sbin/parental-domains refresh >/dev/null 2>&1
*/30 * * * * /usr/sbin/dnslog-rotate >/dev/null 2>&1
0 0,12 * * * /usr/sbin/dnslog-clear >/dev/null 2>&1
*/30 * * * * /usr/sbin/port-scan-all >/dev/null 2>&1
0 4 1 * * /usr/sbin/oui-update >/dev/null 2>&1
0 5 * * 0 /usr/sbin/dnscat-update >/dev/null 2>&1

# Uplink switch notices (Telegram). The daily line is a dead-man's switch:
# if it stops arriving, the router is offline or wedged.
0 9 * * * /usr/sbin/wan-notify heartbeat >/dev/null 2>&1
