#!/bin/sh
# TCP port probe for one LAN device (top common ports).
ip="$1"
[ -n "$ip" ] || exit 1
case "$ip" in
	*[!0-9.]*|"") exit 1 ;;
esac

PORTS="21 22 23 25 53 80 110 139 143 443 445 515 631 993 995 1883 3306 3389 5000 5900 8000 8080 8443 9100 32400"
TMP=/tmp/portscan.$$

: > "$TMP"
for p in $PORTS; do
	( timeout 1 nc "$ip" "$p" < /dev/null > /dev/null 2>&1 && echo "$p" >> "$TMP" ) &
done
wait

sort -n "$TMP" | tr '\n' ' ' | sed 's/ *$//'
rm -f "$TMP"
