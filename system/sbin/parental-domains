#!/bin/sh
# Scheduled parental domain blocking.
# Active `config domain` rules are mapped to ipsets:
#   target 'all'        -> pcall
#   target 'mac:AA:...' -> pd_<12hex>
# and written to a dnsmasq include; parental-control drops traffic to those IPs.
. /lib/functions.sh

CONF=parental
DNS_CONF=/tmp/dnsmasq.d/parental-domains.conf

SETS=""
RULES=""
ALLDOMAINS=""

day_num() {
	case "$1" in
		mon|monday|1) echo 1 ;; tue|tuesday|2) echo 2 ;;
		wed|wednesday|3) echo 3 ;; thu|thursday|4) echo 4 ;;
		fri|friday|5) echo 5 ;; sat|saturday|6) echo 6 ;;
		sun|sunday|0|7) echo 7 ;; *) echo "" ;;
	esac
}

day_match() {
	local cur="$1"; shift
	local tok a b i
	for tok in $(echo "$*" | tr ',' ' '); do
		case "$tok" in
			""|none) continue ;;
			'*'|all|everyday) return 0 ;;
			*-*)
				a=$(day_num "${tok%%-*}"); b=$(day_num "${tok#*-}")
				[ -n "$a" ] && [ -n "$b" ] || continue
				if [ "$a" -le "$b" ]; then
					i=$a; while [ "$i" -le "$b" ]; do [ "$i" -eq "$cur" ] && return 0; i=$((i+1)); done
				else
					i=$a; while [ "$i" -le 7 ]; do [ "$i" -eq "$cur" ] && return 0; i=$((i+1)); done
					i=1; while [ "$i" -le "$b" ]; do [ "$i" -eq "$cur" ] && return 0; i=$((i+1)); done
				fi
				;;
			*) a=$(day_num "$tok"); [ -n "$a" ] && [ "$a" -eq "$cur" ] && return 0 ;;
		esac
	done
	return 1
}

to_min() {
	local h=${1%%:*} m=${1#*:}
	[ "$m" = "$1" ] && m=0
	h=${h#0}; m=${m#0}
	[ -z "$h" ] && h=0
	[ -z "$m" ] && m=0
	echo $((h * 60 + m))
}

window_match() {
	local s e n
	s=$(to_min "$1"); e=$(to_min "$2"); n=$(to_min "$3")
	[ "$s" -eq "$e" ] && return 0
	if [ "$s" -lt "$e" ]; then
		[ "$n" -ge "$s" ] && [ "$n" -lt "$e" ]
	else
		[ "$n" -ge "$s" ] || [ "$n" -lt "$e" ]
	fi
}

collect() {
	local now_dow now_hm

	now_dow=$(date +%u)
	now_hm=$(date +%H:%M)

	handle_rule() {
		local cfg="$1" enabled domain target start end days set
		config_get_bool enabled "$cfg" enabled 1
		config_get domain "$cfg" domain
		config_get target "$cfg" target all
		config_get start "$cfg" start 00:00
		config_get end "$cfg" end 24:00
		config_get days "$cfg" days ""

		[ "$enabled" = "1" ] || return
		[ -n "$domain" ] || return
		[ -n "$days" ] || days="*"

		day_match "$now_dow" "$days" || return
		window_match "$start" "$end" "$now_hm" || return

		case "$target" in
			mac:*)
				set="pd_$(echo "${target#mac:}" | tr -d ':')"
				;;
			*)
				set=pcall
				;;
		esac

		RULES="${RULES}ipset=/${domain}/${set}
"
		SETS="$SETS $set"
		ALLDOMAINS="$ALLDOMAINS $domain"
	}

	config_load "$CONF"
	config_foreach handle_rule domain
}

do_refresh() {
	for d in $ALLDOMAINS; do
		nslookup "$d" 127.0.0.1 >/dev/null 2>&1
	done
}

mkdir -p /tmp/dnsmasq.d
collect

NEW=$(printf "%s" "$RULES")
OLD=$(cat "$DNS_CONF" 2>/dev/null)
CHANGED=0

if [ "$NEW" != "$OLD" ]; then
	printf "%s" "$RULES" > "$DNS_CONF"
	CHANGED=1
fi

for s in $SETS; do
	ipset create "$s" hash:net -exist
	[ "$CHANGED" = 1 ] && ipset flush "$s" 2>/dev/null
done

# Flush sets that no longer have active rules (iptables may still reference them).
for s in $(ipset list -n 2>/dev/null | grep -E '^(pcall|pd_)'); do
	case " $SETS " in
		*" $s "*) ;;
		*) ipset flush "$s" 2>/dev/null ;;
	esac
done

if [ "$CHANGED" = 1 ]; then
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	do_refresh
fi

case "$1" in
	refresh) do_refresh ;;
esac
exit 0
