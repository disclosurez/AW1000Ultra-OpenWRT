#!/bin/sh
# Populate the ARP table with static/quiet wired and wireless clients so the
# Parental Control device list can show them.
scan() {
	local net="$1" max="$2" i=0
	while [ "$i" -lt "$max" ]; do
		i=$((i + 1))
		ping -c1 -W1 -q "$net.$i" >/dev/null 2>&1 &
		if [ $((i % 64)) -eq 0 ]; then wait; fi
	done
	wait
}

scan 192.168.0 254
scan 192.168.5 199
exit 0
