#!/bin/sh
# wan-notify — ping the phone when the uplink switches (Telegram bot).
#
#   wan-notify sim|isp <reason>   send a switch notice (called by wan-failover)
#   wan-notify heartbeat          daily "still alive" message (missing = alarm)
#   wan-notify test               send a test message, print the API reply
#   wan-notify chatid             print chat ids that have written to the bot
#   wan-notify status             show config + cooldown state
#
# Config: /etc/wan-notify.conf (0600).  The bot token is never passed in argv:
# curl is driven from a 0600 --config file that is deleted immediately.

CONF=/etc/wan-notify.conf
TAG=wan-notify
STATUS=/tmp/wanfailover.status
STATE_FILE=/tmp/wan-notify.last
LOG=/tmp/wan-notify.log

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
TG_TOKEN=${TG_TOKEN:-}
TG_CHAT=${TG_CHAT:-}
MUTE=${MUTE:-300}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log() {
	logger -t "$TAG" "$*"
	echo "$(now) $*" >> "$LOG"
	if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 65536 ]; then
		tail -c 32768 "$LOG" > "$LOG.t" && mv "$LOG.t" "$LOG"
	fi
}

sval() { sed -n "s/^$1=//p" "$STATUS" 2>/dev/null; }

cfgfile() { # cfgfile <url> [data ...]  -> path (0600, caller removes)
	local f
	f=$(mktemp /tmp/wan-notify.XXXXXX) || return 1
	chmod 600 "$f"
	printf 'url = "%s"\n' "$1" > "$f"
	shift
	while [ $# -gt 0 ]; do
		printf 'data = "%s"\n' "$1" >> "$f"
		shift
	done
	echo "$f"
}

tg_one() { # tg_one <chat_id> <encoded html text> -> 0 on HTTP 200
	local f code resp rc
	resp=/tmp/wan-notify.reply
	f=$(mktemp /tmp/wan-notify.XXXXXX) || return 1
	chmod 600 "$f"
	{
		printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TG_TOKEN"
		printf 'data = "chat_id=%s"\n' "$1"
		printf 'data = "parse_mode=HTML"\n'
		printf 'data = "disable_web_page_preview=true"\n'
		printf 'data = "text=%s"\n' "$2"
	} > "$f"
	code=$(curl -4 -s -m 10 -o "$resp" -w '%{http_code}' --config "$f" 2>/dev/null)
	rc=$?
	rm -f "$f"
	[ "$rc" = 0 ] || { log "curl failed (rc=$rc)"; return 1; }
	[ "$code" = 200 ] && return 0
	log "telegram HTTP $code: $(head -c 200 "$resp" 2>/dev/null)"
	return 1
}

tg() { # tg <text> -> 0 if every configured chat got it
	local text ids id rc=0
	# a newline inside a curl --config value breaks the parser: send %0A
	text=$(printf '%s\n' "$1" | awk 'BEGIN{ORS=""} NR>1{printf "%%0A"} {print}' \
		| sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
	ids=$(echo "$TG_CHAT" | tr ',' ' ')
	for id in $ids; do
		tg_one "$id" "$text" || rc=1
	done
	return $rc
}

send_retry() { # send_retry <text>
	local i=1
	while [ "$i" -le 3 ]; do
		tg "$1" && { log "sent"; return 0; }
		[ "$i" -lt 3 ] && sleep 5
		i=$((i + 1))
	done
	log "giving up after 3 attempts"
	return 1
}

dur() { # dur <seconds> -> "4h 31m" / "6m 12s" / "45s"
	local s=${1:-0} d h m
	case "$s" in ''|*[!0-9]*) return 0 ;; esac
	[ "$s" -gt 0 ] || { echo "0s"; return 0; }
	d=$((s / 86400)); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
	if [ "$d" -gt 0 ]; then echo "${d}d ${h}h"
	elif [ "$h" -gt 0 ]; then echo "${h}h ${m}m"
	elif [ "$m" -gt 0 ]; then echo "${m}m $((s % 60))s"
	else echo "${s}s"
	fi
}

epoch_of() { # epoch_of <ISO8601Z> -> epoch (empty if unusable)
	case "$1" in ''|'-') return 0 ;; esac
	date -u -D '%Y-%m-%dT%H:%M:%SZ' -d "$1" +%s 2>/dev/null
}

esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

get_pub() { # sets PUB (+ PUB_LOC); silent when the lookup fails
	local t
	t=$(curl -4 -s -m 6 https://cloudflare.com/cdn-cgi/trace 2>/dev/null)
	PUB=$(printf '%s\n' "$t" | sed -n 's/^ip=//p' | head -1)
	PUB_LOC=$(printf '%s\n' "$t" | sed -n 's/^loc=//p' | head -1)
	case "$PUB" in
	''|*[!0-9.]*) PUB='' PUB_LOC='' ;;
	esac
}

pretty_reason() { # "ISP down 2x" -> "ISP failed 2 probes"
	echo "$1" | sed -e 's/ISP down \([0-9]*\)x/ISP failed \1 probes/' \
	               -e 's/ISP recovered \([0-9]*\)x/ISP answered \1 probes/'
}

compose() { # compose <state> <reason> [previous_since]
	local st=$1 why=$2 prev=$3 wip mip head note ago pe clock
	wip=$(sval wan_ip); mip=$(sval modem_ip)
	why=$(pretty_reason "${why:-manual}")
	pe=$(epoch_of "$prev")
	[ -n "$pe" ] && ago=$(dur $(( $(date +%s) - pe )))
	clock=$(date -u +%H:%M:%S)
	get_pub
	case "$st" in
	sim) head='📶 <b>Switched to mobile data</b>'
	     [ -n "$ago" ] && note="ISP had been up $ago" ;;
	isp) head='🔌 <b>Back on the wired uplink</b>'
	     [ -n "$ago" ] && note="SIM held $ago" ;;
	*)   head="<b>Uplink → $(esc "$st")</b>" ;;
	esac

	printf '%s\n' "$head"
	if [ -n "$note" ]; then printf '%s · %s\n' "$(esc "$why")" "$note"
	else printf '%s\n' "$(esc "$why")"; fi
	printf '\n'
	if [ "$st" = sim ]; then
		if [ "$mip" != "-" ] && [ -n "$mip" ]; then
			printf 'SIM  <code>%s</code>  modem link\n' "$(esc "$mip")"
		else
			printf 'SIM  <i>no address yet</i>\n'
		fi
		if [ -n "$PUB" ]; then
			printf 'WAN  <code>%s</code>  public' "$(esc "$PUB")"
			[ -n "$PUB_LOC" ] && printf ' · %s' "$(esc "$PUB_LOC")"
			printf '\n'
		fi
	else
		if [ "$wip" != "-" ] && [ -n "$wip" ]; then
			printf 'WAN  <code>%s</code>  public' "$(esc "$wip")"
		else
			printf 'WAN  <i>no address</i>'
		fi
		[ -n "$PUB_LOC" ] && printf ' · %s' "$(esc "$PUB_LOC")"
		printf '\n'
		[ "$mip" != "-" ] && [ -n "$mip" ] && printf 'SIM  <i>parked</i>\n'
	fi
	printf '\n%s UTC\n' "$clock"
}

compose_hb() { # daily "still alive" line
	local st since ago clock pe
	st=$(sval state); since=$(sval since)
	[ -n "$st" ] || st=unknown
	pe=$(epoch_of "$since")
	[ -n "$pe" ] && ago=$(dur $(( $(date +%s) - pe )))
	clock=$(date -u +%H:%M:%S)
	get_pub
	printf '<b>✅ Router alive</b>\n'
	printf 'Uplink %s' "$(echo "$st" | tr 'a-z' 'A-Z')"
	[ -n "$ago" ] && printf ' · up %s' "$ago"
	printf '\n\n'
	if [ "$st" = sim ]; then
		[ -n "$PUB" ] && printf 'WAN  <code>%s</code>  public\n' "$(esc "$PUB")"
		printf 'SIM  <code>%s</code>  modem link\n' "$(esc "$(sval modem_ip)")"
	else
		printf 'WAN  <code>%s</code>  public' "$(esc "$(sval wan_ip)")"
		[ -n "$PUB_LOC" ] && printf ' · %s' "$(esc "$PUB_LOC")"
		printf '\n'
	fi
	printf '\n%s UTC\n' "$clock"
}

# A flapping ISP can switch every 30 s; keep at most one message per MUTE
# seconds and report how many were held back.
read_state() {
	LAST_TS=-; LAST_ST=; SUPP=0; SENT_ST=
	[ -r "$STATE_FILE" ] && read -r LAST_TS LAST_ST SUPP SENT_ST < "$STATE_FILE"
	# migrate the 3-field format written before SENT_ST existed
	if [ -z "$SENT_ST" ] && [ "${SUPP:-0}" = 0 ]; then
		SENT_ST=$LAST_ST
	fi
}

write_state() { # write_state <epoch> <state> <suppressed> [sent_state]
	printf '%s %s %s %s\n' "$1" "$2" "$3" "${4:-}" > "$STATE_FILE"
}

mark_sent() { write_state "$(date +%s)" "$1" 0 "$1"; }

may_send() { # may_send <state> -> 0 send, 1 suppressed
	local t n
	[ "$MUTE" -gt 0 ] || return 0
	read_state
	if [ "$LAST_TS" != - ] && [ -n "$LAST_TS" ]; then
		t=$(( $(date +%s) - LAST_TS ))
		if [ "$t" -lt "$MUTE" ]; then
			n=$(( ${SUPP:-0} + 1 ))
			write_state "$(date +%s)" "$1" "$n" "$SENT_ST"
			log "suppressed ($1, ${t}s into ${MUTE}s cooldown)"
			return 1
		fi
	fi
	write_state "$(date +%s)" "$1" 0 "$SENT_ST"
	return 0
}

if [ -z "$TG_TOKEN" ] || [ -z "$TG_CHAT" ]; then
	case "$1" in
	test|chatid|status) ;;
	*) log "no Telegram token/chat in $CONF — not sending"; exit 0 ;;
	esac
fi

case "$1" in
sim|isp)
	# wan-failover calls this the instant the route changes; give it a moment
	# to write the fresh status file, then report. $3 is the ISO start of the
	# state being left, so the message can say how long it lasted.
	sleep 2
	may_send "$1" || exit 0
	msg=$(compose "$1" "${2:-manual}" "$3")
	if [ "${SUPP:-0}" -gt 0 ]; then
		msg="$msg<i>+$SUPP earlier switch(es) held back by the cooldown</i>
"
	fi
	send_retry "$msg" && mark_sent "$1"
	;;
init)
	# A watchdog restart must not leave the last alert lying: if the uplink
	# settled somewhere other than what we last reported, say so. A real
	# reboot has no state file (/tmp is RAM), so boots stay silent.
	read_state
	if [ -z "$SENT_ST" ]; then
		log "boot — no notification"
		exit 0
	fi
	[ "$SENT_ST" = "$2" ] && { log "init $2 already reported — silent"; exit 0; }
	sleep 2
	send_retry "$(compose "$2" "${3:-watchdog restart}" "$4")" && mark_sent "$2"
	;;
heartbeat)
	[ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ] || exit 0
	send_retry "$(compose_hb)"
	;;
test)
	# Renders the real layout for the current uplink; "test sim|isp" previews
	# the other branch, and an optional ISO timestamp shows the duration line.
	# Never touches the cooldown state.
	[ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ] || {
		echo "set TG_TOKEN and TG_CHAT in $CONF first" >&2; exit 1; }
	st=${2:-$(sval state)}
	case "$st" in sim|isp) ;; *) st=isp ;; esac
	msg=$(compose "$st" "test message — no switch happened" "${3:-}")
	printf '%s\n' "$msg"
	printf '%s\n' "--- sending ---"
	tg "$msg" && { log "test sent"; echo "delivered"; } || exit 1
	;;
chatid)
	[ -n "$TG_TOKEN" ] || { echo "set TG_TOKEN in $CONF first" >&2; exit 1; }
	f=$(cfgfile "https://api.telegram.org/bot${TG_TOKEN}/getUpdates")
	out=$(curl -4 -sS -m 10 --config "$f")
	rm -f "$f"
	ids=$(echo "$out" | grep -o '"chat":{"id":-\{0,1\}[0-9]\{1,\}' | sed 's/.*"id"://' | sort -u)
	if [ -n "$ids" ]; then
		echo "$ids"
	else
		echo "no chats yet — open the bot in Telegram, press START, send /start" >&2
		echo "$out" >&2
		exit 1
	fi
	;;
status)
	echo "config:   $CONF"
	echo "token:    $([ -n "$TG_TOKEN" ] && echo present || echo MISSING)"
	echo "chat:     ${TG_CHAT:-MISSING}"
	echo "cooldown: ${MUTE}s"
	[ -r "$STATE_FILE" ] && { printf 'last:     '; cat "$STATE_FILE"; }
	echo "uplink:   $(sval state) since $(sval since)"
	[ -s "$LOG" ] && { echo "--- recent ---"; tail -5 "$LOG"; }
	;;
*)
	echo "usage: $0 sim|isp <reason> [prev_since] | init <state> [reason] | heartbeat | test [sim|isp] | chatid | status" >&2
	exit 1
	;;
esac
