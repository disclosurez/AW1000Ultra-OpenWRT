#!/bin/sh
# wan-notify — alert the phone when the uplink switches (Telegram / Discord).
#
#   wan-notify sim|isp <reason> [previous_since]
#   wan-notify init <state> [reason] [previous_since]
#   wan-notify heartbeat
#   wan-notify test [sim|isp]
#   wan-notify chatid
#   wan-notify status
#
# Configuration is UCI (/etc/config/notify, edited in System -> Notifications).
# Credentials live in their own 0600 files and are never passed in argv:
#   telegram_token_file   bot token
#   discord_webhook_file  webhook URL
#
# A legacy /etc/wan-notify.conf is still honoured when /etc/config/notify is
# absent, so an upgrade from the first version keeps working.

TAG=wan-notify
LEGACY=/etc/wan-notify.conf
STATUS=/tmp/wanfailover.status
STATE_FILE=/tmp/wan-notify.last
LOG=/tmp/wan-notify.log
TPL_SWITCH=/etc/notify.template.switch
TPL_HB=/etc/notify.template.heartbeat

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log() {
	logger -t "$TAG" "$*"
	echo "$(now) $*" >> "$LOG"
	if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 65536 ]; then
		tail -c 32768 "$LOG" > "$LOG.t" && mv "$LOG.t" "$LOG"
	fi
}

sval() { sed -n "s/^$1=//p" "$STATUS" 2>/dev/null; }

load_conf() {
	if [ -f /etc/config/notify ]; then
		PROVIDER=$(uci -q get notify.settings.provider)
		TG_CHAT=$(uci -q get notify.settings.chat)
		MUTE=$(uci -q get notify.settings.mute)
		ON_SWITCH=$(uci -q get notify.settings.on_switch)
		ON_HB=$(uci -q get notify.settings.on_heartbeat)
		ENABLED=$(uci -q get notify.settings.enabled)
		TG_FILE=$(uci -q get notify.settings.telegram_token_file)
		DC_FILE=$(uci -q get notify.settings.discord_webhook_file)
	else
		ENABLED=1
		PROVIDER=telegram
		ON_SWITCH=1
		ON_HB=1
		TG_FILE=
		DC_FILE=
		# shellcheck disable=SC1090
		[ -r "$LEGACY" ] && . "$LEGACY"
	fi

	[ -n "$PROVIDER" ] || PROVIDER=telegram
	[ -n "$MUTE" ] || MUTE=300
	[ -n "$TG_FILE" ] || TG_FILE=/etc/notify.telegram.token
	[ -n "$DC_FILE" ] || DC_FILE=/etc/notify.discord.webhook

	# a UCI install with no telegram token file falls back to the legacy value
	if [ -r "$TG_FILE" ]; then
		TG_TOKEN=$(tr -d ' \r\n\t' < "$TG_FILE" 2>/dev/null)
	fi
	[ -n "$TG_TOKEN" ] || TG_TOKEN=${TG_TOKEN:-}
	if [ -r "$DC_FILE" ]; then
		DC_WEBHOOK=$(tr -d ' \r\n' < "$DC_FILE" 2>/dev/null)
	fi
	[ -n "$DC_WEBHOOK" ] || DC_WEBHOOK=${DC_WEBHOOK:-}
}

# Provider gate: selected in the UI *and* actually configured.
have_tg() {
	case "$PROVIDER" in telegram|both) ;; *) return 1 ;; esac
	[ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ]
}

have_dc() {
	case "$PROVIDER" in discord|both) ;; *) return 1 ;; esac
	[ -n "$DC_WEBHOOK" ]
}

cfgfile() { # cfgfile <url> [data ...] -> path (0600, caller removes)
	local f
	f=$(mktemp /tmp/wan-notify.XXXXXX) || return 1
	chmod 600 "$f"
	printf 'url = "%s"\n' "$1" > "$f"
	shift
	while [ $# -gt 0 ]; do
		printf 'data = "%s"\n' "$1" >> "$f"
		shift
	done
	echo "$f"
}

tg_one() { # tg_one <chat_id> <encoded html> -> 0 on HTTP 200
	local f code resp rc
	resp=/tmp/wan-notify.reply
	f=$(mktemp /tmp/wan-notify.XXXXXX) || return 1
	chmod 600 "$f"
	{
		printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TG_TOKEN"
		printf 'data = "chat_id=%s"\n' "$1"
		printf 'data = "disable_web_page_preview=true"\n'
		printf 'data = "text=%s"\n' "$2"
	} > "$f"
	code=$(curl -4 -s -m 10 -o "$resp" -w '%{http_code}' --config "$f" 2>/dev/null)
	rc=$?
	rm -f "$f"
	[ "$rc" = 0 ] || { log "telegram curl failed (rc=$rc)"; return 1; }
	[ "$code" = 200 ] && return 0
	log "telegram HTTP $code: $(head -c 200 "$resp" 2>/dev/null)"
	return 1
}

tg() { # tg <html text> -> 0 if every configured chat got it
	local text ids id rc=0
	# a newline inside a curl --config value breaks the parser: send %0A
	text=$(printf '%s\n' "$1" | awk 'BEGIN{ORS=""} NR>1{printf "%%0A"} {print}' \
		| sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
	ids=$(echo "$TG_CHAT" | tr ',' ' ')
	for id in $ids; do
		tg_one "$id" "$text" || rc=1
	done
	return $rc
}

discord_send() { # discord_send <markdown text> -> 0 on 200/204
	local f code resp rc
	resp=/tmp/wan-notify.reply
	# JSON payload written to a file: no quoting games in the curl config
	printf '%s\n' "$1" | awk '
		BEGIN { printf "{\"username\":\"Router\",\"content\":\"" }
		{
			gsub(/\\/, "\\\\"); gsub(/"/, "\\\"")
			if (NR > 1) printf "\\n"
			printf "%s", $0
		}
		END { printf "\"}" }' > /tmp/notify.payload

	f=$(mktemp /tmp/wan-notify.XXXXXX) || return 1
	chmod 600 "$f"
	{
		printf 'url = "%s"\n' "$DC_WEBHOOK"
		printf 'header = "Content-Type: application/json"\n'
		printf 'data-binary = "@/tmp/notify.payload"\n'
	} > "$f"
	code=$(curl -4 -s -m 10 -o "$resp" -w '%{http_code}' --config "$f" 2>/dev/null)
	rc=$?
	rm -f "$f" /tmp/notify.payload
	[ "$rc" = 0 ] || { log "discord curl failed (rc=$rc)"; return 1; }
	case "$code" in
	200|204) return 0 ;;
	esac
	log "discord HTTP $code: $(head -c 200 "$resp" 2>/dev/null)"
	return 1
}

send_once() { # send_once <html text> -> 0 if every enabled provider took it
	local rc=0
	if have_tg; then tg "$1" || rc=1; fi
	if have_dc; then discord_send "$1" || rc=1; fi
	if ! have_tg && ! have_dc; then
		log "no provider configured (provider=$PROVIDER, token=$([ -n "$TG_TOKEN" ] && echo yes || echo no), webhook=$([ -n "$DC_WEBHOOK" ] && echo yes || echo no))"
		return 2
	fi
	return $rc
}

send_retry() {
	local i=1
	while [ "$i" -le 3 ]; do
		send_once "$1" && { log "sent"; return 0; }
		[ "$i" -lt 3 ] && sleep 5
		i=$((i + 1))
	done
	log "giving up after 3 attempts"
	return 1
}

dur() { # seconds -> "4h 31m" / "6m 12s" / "45s"
	local s=${1:-0} d h m
	case "$s" in ''|*[!0-9]*) return 0 ;; esac
	[ "$s" -gt 0 ] || { echo "0s"; return 0; }
	d=$((s / 86400)); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
	if [ "$d" -gt 0 ]; then echo "${d}d ${h}h"
	elif [ "$h" -gt 0 ]; then echo "${h}h ${m}m"
	elif [ "$m" -gt 0 ]; then echo "${m}m $((s % 60))s"
	else echo "${s}s"
	fi
}

epoch_of() { # <ISO8601Z> -> epoch
	case "$1" in ''|'-') return 0 ;; esac
	date -u -D '%Y-%m-%dT%H:%M:%SZ' -d "$1" +%s 2>/dev/null
}

esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

get_pub() { # sets PUB (+ PUB_LOC); silent when the lookup fails
	local t
	t=$(curl -4 -s -m 6 https://cloudflare.com/cdn-cgi/trace 2>/dev/null)
	PUB=$(printf '%s\n' "$t" | sed -n 's/^ip=//p' | head -1)
	PUB_LOC=$(printf '%s\n' "$t" | sed -n 's/^loc=//p' | head -1)
	case "$PUB" in
	''|*[!0-9.]*) PUB='' PUB_LOC='' ;;
	esac
}

pretty_reason() {
	echo "$1" | sed -e 's/ISP down \([0-9]*\)x/ISP failed \1 probes/' \
	               -e 's/ISP recovered \([0-9]*\)x/ISP answered \1 probes/'
}

fill() { # template on stdin, key=value pairs as arguments
	local tpl k v
	tpl=$(cat)
	while [ "$#" -gt 0 ]; do
		k=${1%%=*}
		v=${1#*=}
		# escape what sed would otherwise interpret in the replacement
		v=$(printf '%s' "$v" | sed -e 's/[\\/&]/\\&/g')
		tpl=$(printf '%s' "$tpl" | sed "s/{$k}/$v/g")
		shift
	done
	printf '%s\n' "$tpl"
}

default_switch_tpl() {
	cat <<'TPL'
{emoji} {headline}
{detail}

Active   {state}
SIM      {sim_ip}
ISP      {isp_ip}
Public   {public_ip} {country}

{date} {time} UTC
TPL
}

default_hb_tpl() {
	cat <<'TPL'
✅ Router alive · {state} · up {uptime}
ISP      {isp_ip}
SIM      {sim_ip}
Public   {public_ip} {country}

{date} {time} UTC
TPL
}

template_of() { # template_of <path> <default-fn>
	local t
	t=$(cat "$1" 2>/dev/null)
	[ -n "$t" ] || t=$($2)
	printf '%s\n' "$t"
}

build_switch() { # build_switch <state> <reason> [previous_since]
	local st=$1 why=$2 prev=$3 emoji headline label held detail pe tpl
	pe=$(epoch_of "$prev")
	[ -n "$pe" ] && held=$(dur $(( $(date +%s) - pe )))

	case "$st" in
	sim) emoji='📶'; headline='Switched to mobile data'; label='SIM'
	     [ -n "$held" ] && held="ISP had been up $held" || held="" ;;
	isp) emoji='🔌'; headline='Back on the wired uplink'; label='ISP'
	     [ -n "$held" ] && held="SIM held $held" || held="" ;;
	*)   emoji='•'; headline="Uplink -> $st"; label=$st ;;
	esac

	why=$(pretty_reason "${why:-manual}")
	if [ -n "$held" ]; then detail="$why · $held"; else detail=$why; fi

	wip=$(sval wan_ip); mip=$(sval modem_ip)
	[ -n "$wip" ] || wip='-'
	if [ -z "$mip" ]; then
		if [ "$st" = isp ]; then mip='parked'; else mip='-'; fi
	fi
	get_pub

	tpl=$(template_of "$TPL_SWITCH" default_switch_tpl)
	printf '%s\n' "$tpl" | fill \
		emoji="$emoji" headline="$headline" detail="$detail" \
		state="$label" sim_ip="$mip" isp_ip="$wip" \
		public_ip="${PUB:--}" country="${PUB_LOC:+($PUB_LOC)}" \
		date="$(date -u +%Y-%m-%d)" time="$(date -u +%H:%M:%S)" \
		hostname="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
}

build_heartbeat() {
	local st since uptime tpl
	st=$(sval state); since=$(sval since)
	[ -n "$st" ] || st=unknown
	uptime='-'
	local pe; pe=$(epoch_of "$since")
	[ -n "$pe" ] && uptime=$(dur $(( $(date +%s) - pe )))

	wip=$(sval wan_ip); mip=$(sval modem_ip)
	[ -n "$wip" ] || wip='-'; [ -n "$mip" ] || mip='-'
	get_pub

	tpl=$(template_of "$TPL_HB" default_hb_tpl)
	printf '%s\n' "$tpl" | fill \
		state="$(echo "$st" | tr 'a-z' 'A-Z')" uptime="$uptime" \
		sim_ip="$mip" isp_ip="$wip" \
		public_ip="${PUB:--}" country="${PUB_LOC:+($PUB_LOC)}" \
		date="$(date -u +%Y-%m-%d)" time="$(date -u +%H:%M:%S)" \
		hostname="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
}

# A flapping ISP can switch every 30 s; keep at most one message per MUTE
# seconds and report how many were held back.
read_state() {
	LAST_TS=-; LAST_ST=; SUPP=0; SENT_ST=
	[ -r "$STATE_FILE" ] && read -r LAST_TS LAST_ST SUPP SENT_ST < "$STATE_FILE"
	if [ -z "$SENT_ST" ] && [ "${SUPP:-0}" = 0 ]; then
		SENT_ST=$LAST_ST
	fi
}

write_state() {
	printf '%s %s %s %s\n' "$1" "$2" "$3" "${4:-}" > "$STATE_FILE"
}

mark_sent() { write_state "$(date +%s)" "$1" 0 "$1"; }

may_send() { # may_send <state> -> 0 send, 1 suppressed
	local t n
	[ "$MUTE" -gt 0 ] || return 0
	read_state
	if [ "$LAST_TS" != - ] && [ -n "$LAST_TS" ]; then
		t=$(( $(date +%s) - LAST_TS ))
		if [ "$t" -lt "$MUTE" ]; then
			n=$(( ${SUPP:-0} + 1 ))
			write_state "$(date +%s)" "$1" "$n" "$SENT_ST"
			log "suppressed ($1, ${t}s into ${MUTE}s cooldown)"
			return 1
		fi
	fi
	write_state "$(date +%s)" "$1" 0 "$SENT_ST"
	return 0
}

load_conf

case "$1" in
sim|isp)
	[ "$ENABLED" = 0 ] && exit 0
	[ "$ON_SWITCH" = 0 ] && exit 0
	sleep 2
	may_send "$1" || exit 0
	msg=$(build_switch "$1" "${2:-manual}" "$3")
	if [ "${SUPP:-0}" -gt 0 ]; then
		msg="$msg
(+$SUPP earlier switch(es) held back by the cooldown)"
	fi
	send_retry "$msg" && mark_sent "$1"
	;;
init)
	[ "$ENABLED" = 0 ] && exit 0
	[ "$ON_SWITCH" = 0 ] && exit 0
	read_state
	if [ -z "$SENT_ST" ]; then
		log "boot — no notification"
		exit 0
	fi
	[ "$SENT_ST" = "$2" ] && { log "init $2 already reported — silent"; exit 0; }
	sleep 2
	send_retry "$(build_switch "$2" "${3:-watchdog restart}" "$4")" && mark_sent "$2"
	;;
heartbeat)
	[ "$ENABLED" = 0 ] && exit 0
	[ "$ON_HB" = 0 ] && exit 0
	send_retry "$(build_heartbeat)"
	;;
test)
	st=${2:-$(sval state)}
	case "$st" in sim|isp) ;; *) st=isp ;; esac
	msg=$(build_switch "$st" "test message — no switch happened" "")
	printf '%s\n' "$msg"
	printf '%s\n' "--- sending ---"
	if send_once "$msg"; then
		log "test sent"
		echo "delivered"
	else
		echo "FAILED (see logread -e $TAG)"
		exit 1
	fi
	;;
template)
	case "$2" in
	switch)    template_of "$TPL_SWITCH" default_switch_tpl ;;
	heartbeat) template_of "$TPL_HB" default_hb_tpl ;;
	*) echo "usage: $0 template switch|heartbeat" >&2; exit 1 ;;
	esac
	;;
chatid)
	[ -n "$TG_TOKEN" ] || { echo "no Telegram token configured" >&2; exit 1; }
	f=$(cfgfile "https://api.telegram.org/bot${TG_TOKEN}/getUpdates")
	out=$(curl -4 -sS -m 10 --config "$f")
	rm -f "$f"
	ids=$(echo "$out" | grep -o '"chat":{"id":-\{0,1\}[0-9]\{1,\}' | sed 's/.*"id"://' | sort -u)
	if [ -n "$ids" ]; then
		echo "$ids"
	else
		echo "no chats yet — open the bot in Telegram, press START, send /start" >&2
		echo "$out" >&2
		exit 1
	fi
	;;
status)
	echo "config:     $([ -f /etc/config/notify ] && echo /etc/config/notify || echo "$LEGACY (legacy)")"
	echo "enabled:    ${ENABLED:-1}"
	echo "provider:   ${PROVIDER:-telegram}"
	echo "telegram:   token $([ -n "$TG_TOKEN" ] && echo present || echo MISSING) · chat ${TG_CHAT:-MISSING}"
	echo "discord:    webhook $([ -n "$DC_WEBHOOK" ] && echo present || echo MISSING)"
	echo "events:     switch=$([ "${ON_SWITCH:-1}" = 0 ] && echo off || echo on) heartbeat=$([ "${ON_HB:-1}" = 0 ] && echo off || echo on)"
	echo "cooldown:   ${MUTE:-300}s"
	echo "templates:  switch $([ -s "$TPL_SWITCH" ] && echo custom || echo default) · heartbeat $([ -s "$TPL_HB" ] && echo custom || echo default)"
	[ -r "$STATE_FILE" ] && { printf 'last:       '; cat "$STATE_FILE"; }
	echo "uplink:     $(sval state) since $(sval since)"
	[ -s "$LOG" ] && { echo "--- recent ---"; tail -5 "$LOG"; }
	;;
*)
	echo "usage: $0 sim|isp <reason> [prev] | init <state> [reason] [prev] | heartbeat | test [sim|isp] | chatid | status" >&2
	exit 1
	;;
esac
