#!/bin/sh
# dnsmasq lease events: keep the accepted-client address set current.
# Enforcement itself is per interface, so this only refreshes the NAT bypass.
[ "$(uci -q get captiveportal.main.mode)" = "local" ] || exit 0
[ "$(uci -q get captiveportal.main.enabled)" = "0" ] && exit 0
/usr/sbin/captiveportal sync >/dev/null 2>&1
exit 0
